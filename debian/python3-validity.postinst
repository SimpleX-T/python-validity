#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "configure" ]; then
    validity-sensors-firmware || true
    systemctl daemon-reload || true
    udevadm control --reload-rules || true
    udevadm trigger || true
    if [ -x /usr/sbin/pam-auth-update ]; then
        pam-auth-update --package --enable fprintd || true
    fi
fi

